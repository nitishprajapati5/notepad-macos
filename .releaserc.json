{
  "branches": ["main"],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "angular",
        "releaseRules": [
          { "type": "feat", "release": "minor" },
          { "type": "fix", "release": "patch" },
          { "type": "perf", "release": "patch" },
          { "type": "refactor", "release": "patch" },
          { "type": "revert", "release": "patch" },
          { "type": "docs", "release": false },
          { "type": "style", "release": false },
          { "type": "chore", "release": false },
          { "type": "ci", "release": false },
          { "type": "test", "release": false }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "angular"
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "plutil -replace CFBundleShortVersionString -string \"${nextRelease.version}\" resources/Info.plist && plutil -replace CFBundleVersion -string \"${process.env.GITHUB_RUN_NUMBER || '1'}\" resources/Info.plist && make package VERSION=${nextRelease.version} BUILD_NUMBER=${process.env.GITHUB_RUN_NUMBER || '1'}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "build/Notepad-macOS-v*.dmg",
            "label": "Notepad macOS Installer (DMG)"
          },
          {
            "path": "build/Notepad-macOS-v*-Universal.zip",
            "label": "Notepad macOS Universal App (ZIP)"
          },
          {
            "path": "build/checksums.txt",
            "label": "SHA-256 Checksums"
          }
        ]
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["CHANGELOG.md", "resources/Info.plist"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ]
  ]
}
